# ==============================================================================
# Cluster Live Studio: Git Ignore
# ==============================================================================

# Build caches and IDE state
cl-binary/
.cl_cache/
.vscode/
ide-plans/
.server.pid

# Allow bundled native runtime objects
!lib/runtime/*.o
!lib/runtime/*.so

# Python & bytecode exclusions
*.py
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp
.DS_Store
